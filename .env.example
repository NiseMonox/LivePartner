# Copy to .env and fill in your own values.
# Real .env is gitignored.
#
# LP_LLM_BASE_URL must point at an OpenAI-compatible endpoint.
# Examples:
#   DashScope (Qwen) :  https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek         :  https://api.deepseek.com/v1
#   OpenAI           :  https://api.openai.com/v1

LP_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LP_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Two-tier model setup per SPEC §5.3.3.
# FLASH: cheap fast gate / summary / compression. Text-only OK.
# PRO  : main generation. MUST be multimodal (vision) — sees game frames.
LP_MODEL_FLASH=qwen3.5-omni-flash
LP_MODEL_PRO=qwen3.5-omni-plus
